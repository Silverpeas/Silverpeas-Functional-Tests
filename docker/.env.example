# Parameters of the functional tests environment. Copy this file to .env and adjust the values.

# Name of the Docker Compose project (prefix of the containers, volumes and network)
COMPOSE_PROJECT_NAME=silverpeas-ft

# Base image providing the Silverpeas installer, Wildfly, Java and the dataset. To update when the
# installer (silversetup plugin) changes.
SILVERPEAS_IMAGE=silverpeas-run:latest

# Version of Silverpeas to install at the container startup. A SNAPSHOT version is taken first from
# the local Maven repository (MAVEN_REPOSITORY) and is always reinstalled at each container start.
SILVERPEAS_VERSION=6.5-SNAPSHOT

# Force the upgrade of Silverpeas at startup even if the version is already installed
FORCE_UPGRADE=false

# Start Silverpeas in debug mode (JPDA on DEBUG_PORT)
SILVERPEAS_DEBUG=false

# Local Maven repository of the host
#MAVEN_REPOSITORY=/home/me/.m2/repository

# Ports published on the host
HTTP_PORT=8380
DEBUG_PORT=5305
MAILPIT_PORT=8325

POSTGRES_VERSION=16
MAILPIT_VERSION=v1.27
